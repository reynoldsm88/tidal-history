setcps (118/60/4)

panic

d1 $ silence


d1 $  stack [
  silence
  , every 3 (striate 6)
    $ degradeBy 0.75
    $ sometimesBy 0.9 ( #speed("< 1.1 1.2 -0.9 0.9>"))
    $ sound "[pad*6]" # n (choose([0,1,2]))
      # up(-5)
      # phaserdepth 1.0
      # gain 0.8
  , degradeBy 0.3
    $ sound "dr55*12" # n (choose([0,1,2,3]))
    #up(-5)
  , every 2 (striate 6)
    $ degradeBy 0.3
    $ sometimesBy 0.5 ( # room 0.5 )
    $ sound "glitch2*7" # n (choose([0,1,2,3,4,5,6]))
      #up(-10)
      # gain 0.8
      # phaserdepth 0.4
  -- , degradeBy 0.6
  --   $ sometimesBy 0.6 (jux(rev))
  --   $ sound "glitch*12" # n (choose([1,2,3,4]))
  , degradeBy 0.4
    $ sound "wobble*11" # n (choose([0,1,2,3,4]))
  -- , sound "bd"
  -- , degradeBy 0.7
  --   $ sometimesBy 0.3 ( #speed("< 1.1 1.2 -0.9 0.9 0.5 -0.7>"))
  --   $ sometimesBy 0.4 (striate 4)
  --   $ sometimesBy 0.1 (striate 3)
  --   $ sometimesBy 0.25 (#crunch 10)
  --   $ sound "breaks125*7" # n (choose([0,1,2,3,4,6,7,8]))
  --   # gain 0.8
  --   # crunch 1
  , degradeBy 0.7
    $ sometimesBy 0.3 ( #speed("< 1.1 1.2 -0.9 0.9 0.5 -0.7>"))
    $ sometimesBy 0.4 (striate 4)
    $ sometimesBy 0.1 (#up(-2))
    $ sound "pad:2"
]


d1 $ stack [
  degradeBy 0.5
    $ every 7 (striate 5)
    $ sometimesBy 0.3 (jux(#speed "-1.3"))
    $ sound "tabla*15" # n (choose([0,1,2,3,4,5,6]))
  , sound "db*7" # n (choose([0,1,2,3,4,5,6]))
    # gain 0.8
]

d2 $ silence
d2 $ stack [
  silence -- ]
  , sometimesBy 0.3 (#up(1.2))
    $ every 5 (striate 2)
    $ sometimesBy 0.25 (#up("-0.8"))
    $ degradeBy 0.5
    $ sound "hand*15" # n (choose([0,1,2,3,4,5,6]))
      # gain 0.9
  , sometimesBy 0.2 (#room 0.4)
    $ every 7 (striate 5)
    $ sometimesBy 0.3 (jux(#speed "-1.3"))
    $ sometimesBy 0.25 (#up("-0.8"))
    $ every 5 (#crush 6)
    $ sound "hand" <| n "[0 ~ 1 ~ 6 ~ ~ ~ ~ ~ 6 ~ 1 ~ ~ 3 ~, 1 ~ ~ ~ ~ 2 ~ 5]"
      # gain 0.8
]

d1 $ silence
d1 $ stack [
  silence -- ]
  -- , every 4 ( (#crush 4) . (#lpf (range 4000 9000 $ slow 4 sine) ) )
  --   $ sound "feel" <| n "[0 ~ ~ 1 ~ 1 ~ 0 ~ ~ 0 ~ 1 ~ 0 ~ ~, 3 ~ ~ 3 ~ ]"
  --     # gain 0.9
  , sometimesBy 0.2 (#room 0.4)
    $ sometimesBy 0.4 (jux(#speed "-1.3"))
    $ sometimesBy 0.3 (jux(#speed "-1.4"))
    $ sometimesBy 0.4 (striate 3)
    $ sound "feelfx" <| n "[1 ~ ~ 2 ~ ~ 2 ~ ~ ~ 0 ~ 2 3 ~ ~ ~, 3 ~ ~ ~ ~ 0 ~ ~]"
      # gain 0.8
]
