setcps (88/60/4)
panic

d1 $ stack [
  silence
  , every 2 (# speed 0.9)
    $ sound "outdoor" <| n "[0 ~ 1 ~ [2 | [2 2] | [2 ~ 2 ~]]]/2"
    # phaserrate 2
    # phaserdepth 10
    # gain 0.8
 -- , sound "noise2*14" # n (irand(5))
]

d2
  $ superimpose ((# speed "2*12") . (# squiz (slow 2 $ range 1 16 $ sine)) . (striate "[1|9|2]") . (ply "[[1 1 2 4]|[1 1 2 2]]") . (# room "0 0.5") . (# sz "0.2 0.4"))
  -- $ whenmod 8 2 (fast 2)
  -- $ whenmod 16 4 (fast 2)
  -- $ whenmod 2 0 (fast 2)
  -- $ whenmod 1 1 (fast 2)
  -- $ stutWith 2 (1/6) (|* speed "1.0")
  -- $ stutWith 2 (1/2) (|* speed "1.0")
  -- $ stutWith 5 (1/16) (|* speed "1.0")
  -- $ stutWith 8 (4/24) (|* speed "1.0")
  -- $ struct "t*6 t/2"
  -- $ struct "~ t*2 t/6!2"
  -- $ struct "t*2 t/6"
  -- $ struct "t*9 t/4"
  -- $ jux (hurry 2)
  -- $ stutter 4 (1/16)
  -- $ stutter 8 (6/2)
  $ slow 25
  -- $ stutWith 3 (1/6) (|* 6)
  -- $ degradeBy 0.6
  -- $ every 3 (chop 4)
  -- $ jux rev $ chunk 2 (fast 8 . (|- n 12)) $ off 0.25 (|+ 7) $ struct (iter 2 "t(6,9)")
  $ loopAt 0.5
  $ striate 2
  $ s "tabla2"
  # amp 0.4
  # room 0.6
  # sz 0.8
  # gain 4
  # legato 1
  # delay 0.2
  # delayt 0.5
  # delayfb 0.7



d2 $ stack [
  silence
  , degradeBy 0.5
    $ sound "[db*16]/7" # n (irand 10)
      # up(-10)
      # size 1.2
  , degradeBy 0.7
    $ jux(rev)
    $ sound "[db(5,16)]/3" # n (irand 5)
      # crush 12
]

d3 $ stack [
  silence -- ]
  ,
]

