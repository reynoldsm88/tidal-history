
setcps (128/60/4)


panic

d1 $ stack [
    silence
    , every 5 (striate 4)
      $ sometimesBy 0.3 (# crush 4)
      $ every 2 ( #nudge (rand) )
      $ sound "clap:1 [~ clak:1] ~ [glitch:1 ~ glitch:2] [ [industrial:2 | industrial:4] ~]/5"
      # speed "1.2 0.9 1.3 1.5 0.9 1.1 1.2"
      # shape 0.4
      # room 0.1 # sz 0.2
      # gain 0.9
    , sometimesBy 0.5 (jux(# speed "-0.9"))
      $ sometimesBy 0.28 (jux(rev))
      $ sound "[glitch*13]/3" # n (choose( [0,1,2,4,5] ) )
        # speed 0.1
        # legato (range (-0.02) 2.0 rand)
        # gain 0.8
    , sometimesBy 0.4 ( (#room 0.9) )
      $ sometimesBy 0.2 (#up (-10))
      $ sound "[clubkick:2 ~ [bd:4 ~] ~, bd:1 ~ ~]/4"
      # shape 0.6
      # lpf 300
      # gain 0.87
    , sometimesBy 0.4 ( (#room 0.9) )
      $ degradeBy 0.3
      $ sound "[miniyeah*24]/2" # n (choose( [2,3,4,5] ))
      # gain 0.87
      # speed 0.1
]
