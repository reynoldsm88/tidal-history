
setcps (130/60/4)


panic

d1 $ stack [
  silence
  , every 5 (striate 4)
    $ sometimesBy 0.3 (#speed "-0.8")
    $ sometimesBy 0.4 ((# ring "<2.5 0.9>") . (# ringf "<200 650 1200 80>"))
    $ degradeBy 0.75
    $ sound "gab*16" # n (choose( [0,1,3] ) )
    # phaserrate 1.0
  ,  every 4 (#delay 0.5)
   $ sound "gabba:6(7,16,14)"
   # legato (range (0.1) 0.5 rand)
   # crunch 12
]

d2 $ stack [
  silence
  , sometimesBy 0.4 (# crush 12)
    $ sometimesBy 0.4 (# ring 5)
    $ sometimesBy 0.6 (# lpf (range 2000 5000 $ slow 2 sine))
    $ sound "gabba" <| n "[0 ~ ~ [~ 0] ~, 1 ~ ~ 1 ~ 1 ~]"
  , sometimesBy 0.4 (# lpf (range 1000 4000 $ slow 2 sine))
    $ sound "gab*7" <| n "[0 ~ ~ ~ [~ ~], ~ [2?0.3 ~ 3?0.5]]"

]

