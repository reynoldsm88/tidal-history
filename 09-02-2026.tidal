panic


setcps (112/60/4)
panic

d1 $ stack [
  silence
  , sound "808bd" <| n "0(5,8,3)/3"
    # gain 0.9
  , degradeBy 0.7
      $ every 8 (# speed "-0.8")
      $ sound "east*21" # n (choose( [1, 3 , 4, 5 ] ) )
        # gain 0.85
  , degradeBy 0.33
    -- $ every 3 ( striate 5 )
    $ every 5 (#speed "-1.0")
    $ every 10 (#room 0.3)
    $ striate "[8 | 5 | 3]"
    $ sound "msg*13" # n ( choose( [0, 1, 2, 3 , 4] ) )
    # cutoff (range 300 4000 $ slow 5 sine)
]

d2 $ stack [
  silence
  , degradeBy 0.33
    $ every 3 ( striate 4 )
    $ every 5 ( #speed "-1.0")
    $ every 10 ( #room 0.3 )
    $ sound "msg*13" # n ( choose( [0, 1, 2, 3 , 4] ) )
  , degradeBy 0.78
      $ sound "lt(8, 5, 3)" # n (choose( [0, 1, 2] ) )
      # gain 0.8
  -- , degradeBy 0.5
  --   $ sound "[less*16]/2" # n (choose( [0, 1, 2, 3, 4, 5] ) )
  --     # speed 1.5
  --     # size 1.2
  , degradeBy 0.3
    $ sound "db*9" # n (irand 6)
]

d3 $ stack [
  silence
  , whenmod 8 3 ( # up "[-1 -6 -3]" )
    $ every 4 ( # speed "0.8" )
    $ degradeBy 0.5
    $ every 3 ( (# crunch 15) . (#room 0.5) )
    $ every 8 ( #speed "-0.7" )
    $ sound "[sid*21, sid*8]" # n (choose ( [0, 1] ) )
      # delay 0.8
      # delaytime 0.4
      # delayfeedback 0.4
] # gain 0.87
